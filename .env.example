# Reactor — runs LingBot World 2. Get a key at https://www.reactor.inc/account/api-keys
REACTOR_API_KEY=rk_your_api_key_here

# OpenRouter — runs both agents (Jev the player, Claude the level designer).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional overrides
# JEV_MODEL=typesafe/jev-1.14            # 1.14+ required for bounding boxes
# DESIGNER_MODEL=anthropic/claude-opus-5.5
# NEXT_PUBLIC_REACTOR_API_URL=https://api.reactor.inc
