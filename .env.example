# Reactor: runs LingBot World 2. https://www.reactor.inc/account/api-keys
REACTOR_API_KEY=rk_your_api_key_here

# Jev (the player). Direct TypeSafe is preferred; OpenRouter also works.
TYPESAFE_API_KEY=
# Level designer: any OpenAI-compatible /chat/completions endpoint with vision.
# Default model is Kimi K3; e.g. DESIGNER_BASE_URL=https://api.openai.com/v1 + DESIGNER_MODEL=<model>
DESIGNER_BASE_URL=
DESIGNER_API_KEY=
# One key that can run both agents instead of the two above.
OPENROUTER_API_KEY=

# Optional overrides
# JEV_MODEL=jev-latest                # typesafe/jev-1.14 on OpenRouter; 1.14+ needed for boxes
# DESIGNER_MODEL=kimi-k3-high         # moonshotai/kimi-k3 on OpenRouter
# NEXT_PUBLIC_REACTOR_API_URL=https://api.reactor.inc

# Image model for the designer (required for "New world"; LingBot needs an opening image)
REPLICATE_API_TOKEN=
# IMAGE_MODEL=google/nano-banana-pro
